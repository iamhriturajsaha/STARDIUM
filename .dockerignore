# Exclude everything that Docker doesn't need to build the image
# This speeds up the build significantly

# Frontend build artifacts (we copy source, not dist)
Frontend/node_modules/
Frontend/dist/
Frontend/.cache/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Environment secrets
.env
Backend/.env

# Git history (not needed in image)
.git/
.gitignore

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Test files
Backend/tests/

# README
README.md
